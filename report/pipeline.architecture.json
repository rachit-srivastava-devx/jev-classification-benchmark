  "cards": [
    {
      "dot": "slate",
      "title": "What is held constant",
      "items": [
        "Same 350 queries for every model",
        "Same 100 candidate passages, in the same retrieval order",
        "Same 1,200-character truncation",
        "Same gold labels and the same two denominators"
      ]
    },
    {
      "dot": "cyan",
      "title": "What varies",
      "items": [
        "The model, and nothing else about the input",
        "For Jev: which of its three documented grammars asks the question",
        "Choice asks once about 100 passages; Noul and Score ask 100 times about one"
      ]
    },
    {
      "dot": "amber",
      "title": "Decided before any result existed",
      "items": [
        "The difficulty stratifier \u2014 no query is dropped, the stratum is published",
        "WANDS Partial counts as a negative, not a partial credit",
        "A query whose sub-calls fail at \u226510% is a failure, not a partial score"
      ]
    }
  ]
